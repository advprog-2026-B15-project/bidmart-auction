# Database (Neon PostgreSQL) ---
# Full JDBC URL from your Neon dashboard
JDBC_DATABASE_URL=jdbc:postgresql://<host>/<db>?sslmode=require
JDBC_DATABASE_USERNAME=your_db_username
JDBC_DATABASE_PASSWORD=your_db_password

# Message Broker (CloudAMQP / RabbitMQ)
RABBITMQ_HOST=your.rmq.cloudamqp.com
RABBITMQ_PORT=5671
RABBITMQ_USERNAME=your_vhost_name
RABBITMQ_PASSWORD=your_rabbitmq_password
RABBITMQ_VHOST=your_vhost_name
RABBITMQ_SSL_ENABLED=true

# Cache & Distributed Lock (Upstash Redis)
# Must use rediss:// (TLS) for Upstash
REDIS_URL=rediss://:your_password@your-host.upstash.io:6379

# Inter-Service URLs
# URL of the Wallet microservice (no trailing slash)
WALLET_SERVICE_URL=http://bidmart-wallet:8084
