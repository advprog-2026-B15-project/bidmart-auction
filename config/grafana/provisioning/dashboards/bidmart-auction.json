{
  "id": null,
  "uid": "bidmart-auction-dashboard",
  "title": "BidMart Auction Service",
  "tags": ["bidmart", "auction"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 2,
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "title": "Total Bids Placed",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area",
        "orientation": "auto"
      },
      "targets": [
        {
          "expr": "auction_bids_placed_total{application=\"bidmart-auction\"}",
          "legendFormat": "Total Bids"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "Active Auctions",
      "type": "stat",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area",
        "orientation": "auto"
      },
      "targets": [
        {
          "expr": "auction_active_count{application=\"bidmart-auction\"}",
          "legendFormat": "Active Auctions"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "blue", "value": null }
            ]
          }
        }
      }
    },
    {
      "id": 6,
      "title": "API Apdex Score (T=0.5s)",
      "type": "gauge",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto"
      },
      "targets": [
        {
          "expr": "(sum(rate(http_server_requests_seconds_bucket{application=\"bidmart-auction\", le=\"0.5\"}[5m])) + sum(rate(http_server_requests_seconds_bucket{application=\"bidmart-auction\", le=\"2.0\"}[5m]))) / 2 / sum(rate(http_server_requests_seconds_count{application=\"bidmart-auction\"}[5m]))",
          "legendFormat": "Apdex Score"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.7 },
              { "color": "green", "value": 0.85 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Bid Rate (per minute)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 4, "w": 6, "h": 8 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "expr": "rate(auction_bids_placed_total{application=\"bidmart-auction\"}[1m]) * 60",
          "legendFormat": "Bids / Minute"
        }
      ]
    },
    {
      "id": 4,
      "title": "Bid Latency (p50, p95, p99)",
      "type": "timeseries",
      "gridPos": { "x": 6, "y": 4, "w": 6, "h": 8 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(auction_bid_latency_seconds_bucket{application=\"bidmart-auction\"}[1m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(auction_bid_latency_seconds_bucket{application=\"bidmart-auction\"}[1m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(auction_bid_latency_seconds_bucket{application=\"bidmart-auction\"}[1m])) by (le))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "id": 5,
      "title": "HTTP Request Rate (all endpoints)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"bidmart-auction\"}[1m])) by (uri, status)",
          "legendFormat": "{{uri}} {{status}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "JVM Heap Memory Usage",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 20, "w": 6, "h": 8 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{application=\"bidmart-auction\", area=\"heap\"}",
          "legendFormat": "Used Heap"
        },
        {
          "expr": "jvm_memory_max_bytes{application=\"bidmart-auction\", area=\"heap\"}",
          "legendFormat": "Max Heap"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      }
    },
    {
      "id": 8,
      "title": "CPU Usage",
      "type": "timeseries",
      "gridPos": { "x": 6, "y": 20, "w": 6, "h": 8 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "expr": "system_cpu_usage{application=\"bidmart-auction\"}",
          "legendFormat": "System CPU"
        },
        {
          "expr": "process_cpu_usage{application=\"bidmart-auction\"}",
          "legendFormat": "Process CPU"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      }
    }
  ]
}
